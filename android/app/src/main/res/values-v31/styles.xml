<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) uses the system SplashScreen API.
         These attributes replace the grey/white system splash with the
         ChiGlow cream background + app icon, then continue into the
         branded launch_background artwork and finally the Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FFF5E6D0</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:postSplashScreenTheme">@style/LaunchTheme</item>
    </style>
    <!-- Theme applied as soon as the process has started, behind the Flutter UI
         while it initializes — always the ChiGlow cream gradient. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/chiglow_splash_bg</item>
    </style>
</resources>
