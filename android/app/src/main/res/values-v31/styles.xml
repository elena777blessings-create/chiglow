<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) uses the system SplashScreen API.
         Kept completely minimal and blank: plain cream background and a
         transparent icon (no logo, no artwork), flowing straight into the
         app's Home screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/chiglow_champagne</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank_icon</item>
    </style>
    <!-- Theme applied as soon as the process has started, behind the Flutter UI
         while it initializes — always the ChiGlow cream gradient. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/chiglow_splash_bg</item>
    </style>
</resources>
